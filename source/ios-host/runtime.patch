+        let mut mask = 0;
+        for (stage, pass) in self.stages.iter().zip(self.passthrough) {
+            if pass { continue; }
+            for source in &stage.color_sources[..stage.color_op.inputs()] {
+                if let Source::Texture(unit) = source { mask |= 1 << unit; }
