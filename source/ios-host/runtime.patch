+            if stage.color_op != Operation::Dot3Rgba {
+                for source in &stage.alpha_sources[..stage.alpha_op.inputs()] {
+                    if let Source::Texture(unit) = source { mask |= 1 << unit; }
+                }
+            }
+        }
