+/// A single active stage with unmodified RGBA sources. Prepared once per
+/// triangle, instead of dispatching six general combiner stages per pixel.
+pub(crate) struct SimpleEnv {
+    operation: Operation,
+    sources: [Source; 2],
+    constant: [f32; 4],
+}
+
+impl SimpleEnv {
+    #[inline]
+    pub(crate) fn apply(&self, primary: [f32; 4], textures: [[f32; 4]; 4], fragment: Option<([f32; 4], [f32; 4])>) -> [f32; 4] {
+        let pick = |source| match source {
+            Source::PrimaryColor | Source::Previous => primary,
+            Source::PrimaryFragmentColor => fragment.map_or(primary, |(diffuse, _)| diffuse),
+            Source::SecondaryFragmentColor => fragment.map_or([0.0, 0.0, 0.0, 1.0], |(_, specular)| specular),
+            Source::Texture(unit) => textures[unit],
+            Source::Constant => self.constant,
+            Source::PreviousBuffer => unreachable!("buffer stages are not specialized"),
+        };
+        let left = pick(self.sources[0]);
+        match self.operation {
+            Operation::Replace => left.map(|v| v.clamp(0.0, 1.0)),
+            Operation::Modulate => {
+                let right = pick(self.sources[1]);
+                std::array::from_fn(|i| (left[i] * right[i]).clamp(0.0, 1.0))
+            }
+            _ => unreachable!("only replace and modulate are specialized"),
+        }
+    }
+}
