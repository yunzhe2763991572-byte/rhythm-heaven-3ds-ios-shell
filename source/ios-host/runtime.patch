 impl TexEnv {
+    pub(crate) fn simple(&self) -> Option<SimpleEnv> {
+        // The first active stage can be preceded only by passthroughs.
+        // Buffer reads depend on stage position and stay on the general path.
+        let mut active = self.stages.iter().zip(self.passthrough).filter(|(_, pass)| !pass).map(|(stage, _)| stage);
+        let stage = active.next()?;
+        if active.next().is_some() { return None; }
+        if stage.color_op != stage.alpha_op || !matches!(stage.color_op, Operation::Replace | Operation::Modulate)
+            || stage.color_scale != 1.0 || stage.alpha_scale != 1.0 { return None; }
+        let count = stage.color_op.inputs();
+        for i in 0..count {
+            if stage.color_sources[i] != stage.alpha_sources[i] || stage.color_operands[i] != 0
+                || stage.alpha_operands[i] != 0 || stage.color_sources[i] == Source::PreviousBuffer { return None; }
+        }
+        Some(SimpleEnv { operation: stage.color_op, sources: [stage.color_sources[0], stage.color_sources[1]], constant: stage.constant })
+    }
